# Claude API (dialogue)
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs (cloud TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Voice-character knobs -- tune these by ear, no code changes needed.
# eleven_flash_v2_5 (fast, cheap) | eleven_multilingual_v2 (more expressive,
# a bit slower -- worth trying if flash still sounds flat/unstable)
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# stability: lower = more expressive but prone to wavering on loud/shouted
# lines; higher = steadier, less glitchy, a bit less spontaneous. 0-1.
ELEVENLABS_STABILITY=0.65
# similarity_boost: how closely to hew to the original voice. 0-1.
ELEVENLABS_SIMILARITY_BOOST=0.8
# style: exaggerates the voice's natural emotion/character on top of
# stability -- more "epic," but stacked with low stability it gets glitchy.
# Raise stability and style together. 0-1.
ELEVENLABS_STYLE=0.35
ELEVENLABS_SPEAKER_BOOST=true

# Ollama endpoint: localhost during Mac dev; the Mac's LAN address once the
# hat runs on the Pi and calls back home for vision.
OLLAMA_URL=http://127.0.0.1:11434
VISION_MODEL=qwen3-vl:8b

CLAUDE_MODEL=claude-opus-5
LANGUAGES=es,en
DEFAULT_LANG=es

# mac | pi — selects which camera/servo backends are viable
PROFILE=mac
CAMERA_INDEX=0

# qwen3-vl:8b is a "thinking" model -- its hidden reasoning pass shares the
# same token budget as the final answer (Ollama's think:false does not
# suppress it on this setup), so a tight timeout can cut it off before it
# ever writes a reply. Measured on this machine's own Ollama: even a
# trivial image took 5-10s: 20s leaves real headroom.
VISION_TIMEOUT_S=20.0
LISTEN_TIMEOUT_S=8.0
SESSION_MAX_S=300.0
MAX_REPLY_TOKENS=500

# elevenlabs | say
HAT_TTS_BACKEND=say
# mock | pca9685 (pca9685 only works once the hardware is wired up)
HAT_SERVO_BACKEND=mock
# Bluetooth speaker output latency, seconds — delays the mouth to match the
# ears. 0.0 on the Mac; tune ~0.15-0.25 by eye once on the Pi + BT speaker.
HAT_OUTPUT_LATENCY_S=0.0

# tiny | base | small | medium — small is the minimum for decent Spanish
HAT_STT_MODEL=small
HAT_WAKE_MODEL=hey_jarvis_v0.1
