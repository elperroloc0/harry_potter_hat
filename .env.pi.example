# Pi-profile env. On the Pi: cp .env.pi.example .env, then fill in the same
# secrets as .env.example (ANTHROPIC_API_KEY, ELEVENLABS_API_KEY,
# ELEVENLABS_VOICE_ID, and the ELEVENLABS_* voice-tuning knobs) -- those
# don't change between profiles, so see .env.example for what each one does.
# Only the values that differ for the Pi are set here.
ANTHROPIC_API_KEY=sk-ant-...
ELEVENLABS_API_KEY=

# pi selects RpicamJpegCamera (rpicam-jpeg CLI) for vision and PCA9685Servos
# (raw duty-cycle, see hat/motion/servos.py) for the mouth/brow servos.
PROFILE=pi

# Ollama runs on the Mac, not the Pi -- point at the Mac's LAN IP, not
# localhost. Check with `ipconfig getifaddr en0` on the Mac; it can change
# on DHCP renewal, so re-check if the hat suddenly can't reach it. Also
# requires, on the Mac: launchctl setenv OLLAMA_HOST "0.0.0.0" then
# killall Ollama (a running instance won't pick up the env var otherwise).
OLLAMA_URL=http://192.168.1.84:11434
# Pull this on the Mac's Ollama first: ollama pull qwen2.5vl:7b
VISION_MODEL=qwen2.5vl:7b
# No hidden reasoning pass (unlike qwen3-vl:8b, dropped for being 3-6x
# slower with no reliable way to suppress its "thinking" -- see
# project_hat_hardware_status memory). Measured live against a real,
# deliberately hard photo (dim light, out of focus, awkward angle): 1.7-2.1s.
VISION_TIMEOUT_S=20.0

# mock | pca9685 -- pca9685 drives the real mouth/brow servos.
HAT_SERVO_BACKEND=pca9685

# BCM GPIO pin the PIR sensor's OUT line is wired to (hat/sensors/motion.py).
# 4 avoids the I2C pins (2/3, used by the PCA9685) -- change to match
# whatever pin you actually wire it to on the bench.
HAT_MOTION_SENSOR_PIN=4

# elevenlabs | say -- "say" only exists on macOS and always fails on the Pi.
# No offline TTS fallback exists yet if the network/ElevenLabs API is down
# (next step: espeak-ng or piper as a local backup).
HAT_TTS_BACKEND=elevenlabs

# Bluetooth speaker adds output lag the mouth needs to match -- 0.2 is a
# starting point, tune by eye once paired with the actual speaker.
HAT_OUTPUT_LATENCY_S=0.2
